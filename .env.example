# =====================================================================
# CareSync — Alexa+ Care Coordination Agent Configuration (.env.example)
# =====================================================================

# Backend API & Streamable HTTP FastMCP Server
APP_NAME="CareSync API"
APP_ENV="development"
APP_VERSION="0.1.0"
DEBUG=true

HOST="127.0.0.1"
PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database & Synthetic Safety Configuration
DATABASE_URL="sqlite:///./caresync_local.db"
SEED_ON_STARTUP=true
SYNTHETIC_DATA_MODE=true

# Simulator Web UI Configuration
SIMULATOR_PORT=3000
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
