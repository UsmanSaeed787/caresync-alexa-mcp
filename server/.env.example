# CareSync Server Configuration
APP_NAME="CareSync API"
APP_ENV="development"
APP_VERSION="0.1.0"
DEBUG=true

# Server Networking
HOST="127.0.0.1"
PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database & Synthetic Safety
DATABASE_URL="sqlite:///./caresync_local.db"
SEED_ON_STARTUP=true
SYNTHETIC_DATA_MODE=true
